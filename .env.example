# ==============================================================================
# DevPilot — Zero-Cost Local Configuration (.env.example)
# All defaults run 100% locally with Docker and Open Source tools.
# No paid subscriptions, API keys, or credit cards required.
# ==============================================================================

# Core Application Settings
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# JWT Authentication (Local direct auth, no Auth0/Clerk required)
JWT_SECRET=devpilot_super_secret_local_jwt_key_32_chars_min!
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# GitHub Integration (Free tier personal token or GitHub App)
GITHUB_CLIENT_ID=optional_local_dev_id
GITHUB_CLIENT_SECRET=optional_local_dev_secret
GITHUB_PERSONAL_ACCESS_TOKEN=

# Database Configuration (PostgreSQL 16 + pgvector running locally via Docker)
# Classification: FREE / OPEN SOURCE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devpilot?schema=public

# In-Memory Cache & Background Queues (Redis Alpine running locally via Docker)
# Classification: FREE / OPEN SOURCE
REDIS_URL=redis://localhost:6379

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000

# ==============================================================================
# AI Provider Abstraction
# Options:
#   - "ollama"  : Local offline model (FREE / OPEN SOURCE, e.g. llama3, mistral, deepseek-coder)
#   - "gemini"  : Google Gemini Free Tier (FREE TIER WITH LIMITS, requires GEMINI_API_KEY)
#   - "mock"    : In-memory synthetic code generation (FREE / OPEN SOURCE, zero GPU/RAM needed)
# ==============================================================================
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b
# If using Gemini free tier:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ==============================================================================
# Vector Database Provider
# Options:
#   - "pgvector": PostgreSQL pgvector extension (FREE / OPEN SOURCE, default)
#   - "qdrant"  : Local Qdrant container (FREE / OPEN SOURCE)
#   - "memory"  : In-memory cosine search fallback (FREE / OPEN SOURCE)
# ==============================================================================
VECTOR_PROVIDER=pgvector
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ==============================================================================
# Object Storage Provider
# Options:
#   - "local": Local filesystem directory (FREE / OPEN SOURCE, default)
#   - "minio": S3-compatible MinIO container (FREE / OPEN SOURCE)
# ==============================================================================
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=devpilot-artifacts
MINIO_USE_SSL=false

# ==============================================================================
# Email Provider
# Options:
#   - "mailpit": Local Mailpit SMTP container with Web UI (FREE / OPEN SOURCE, default)
#   - "console": Emits emails to server stdout (FREE / OPEN SOURCE)
# ==============================================================================
EMAIL_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@devpilot.local

# ==============================================================================
# Code Execution Sandbox
# Options:
#   - "docker": Spawns ephemeral Docker container with resource quotas (FREE / OPEN SOURCE)
#   - "process": Spawns node/python subprocess in sandboxed directory (Fallback)
# ==============================================================================
SANDBOX_PROVIDER=docker
SANDBOX_TIMEOUT_MS=30000
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0

# ==============================================================================
# Observability & Monitoring (Prometheus + Grafana + OpenTelemetry)
# Classification: FREE / OPEN SOURCE
# ==============================================================================
PROMETHEUS_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
